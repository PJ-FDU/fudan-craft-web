{
  "name": "fudancraft-web",
  "version": "2.3.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets:runtime": "node scripts/build-runtime-assets.mjs",
    "check:runtime": "node --import tsx scripts/check-runtime-assets.ts",
    "predev": "npm run assets:runtime",
    "predev:pages": "npm run assets:runtime",
    "prebuild": "npm run assets:runtime",
    "prebuild:pages": "npm run assets:runtime",
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "dev:pages": "vite --mode pages --port 4330",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "check:release": "npm test && npm run build && npm run build:pages && node scripts/check-pages-build.mjs",
    "preview:pages": "vite preview --mode pages --port 4330",
    "start": "node dist-server/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "benchmark": "node --import tsx scripts/benchmark-balance.ts",
    "benchmark:outposts": "node --import tsx scripts/benchmark-outposts.ts",
    "assets": "node scripts/import-assets.mjs",
    "assets:blender": "node scripts/build-blender-assets.mjs",
    "assets:sculpt": "node scripts/build-sculpt-assets.mjs",
    "assets:worker": "node scripts/build-worker-hero.mjs",
    "assets:sniper": "node scripts/build-sniper-hero.mjs",
    "assets:rifleman": "node scripts/build-rifleman.mjs",
    "assets:hero": "node scripts/build-hero.mjs",
    "check:blender": "node --import tsx scripts/check-blender-assets.ts",
    "audio:generate": "node --import tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "@metered-ca/realtime": "1.2.1",
    "three": "^0.187.0",
    "three-gpu-pathtracer": "0.0.28",
    "three-mesh-bvh": "0.9.17",
    "ws": "^8.18.0",
    "xatlas-web": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.5.13",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
