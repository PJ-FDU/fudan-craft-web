{
  "name": "fudancraft-web",
  "version": "2.3.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "dev:pages": "vite --mode pages --port 4330",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "check:release": "npm test && npm run build && npm run build:pages && node scripts/check-pages-build.mjs",
    "preview:pages": "vite preview --mode pages --port 4330",
    "start": "node dist-server/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "benchmark": "node --import tsx scripts/benchmark-balance.ts",
    "benchmark:outposts": "node --import tsx scripts/benchmark-outposts.ts",
    "assets": "node scripts/import-assets.mjs",
    "audio:generate": "node --import tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "@metered-ca/realtime": "1.2.1",
    "three": "^0.187.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
