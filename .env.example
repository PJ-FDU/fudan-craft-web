# Set this in the shell before starting the server, e.g. PORT=8080 npm start.
# The server does not automatically load .env files.
PORT=4320
# Use 127.0.0.1 when a reverse proxy on this host is the public entry point.
# LISTEN_HOST=127.0.0.1
# Mount this directory on persistent storage when deploying in a container.
ROOM_STORE_DIR=.rooms
# Optional reconnect reservation duration in milliseconds; default is 120000.
ROOM_RECONNECT_MS=120000
# Public WebSocket service. See the public deployment section in README.md.
# Exact browser origins, comma-separated, with no trailing slash.
# WS_ALLOWED_ORIGINS=https://play.example.com
# Direct proxy IPs, comma-separated. The proxy must overwrite X-Real-IP.
# WS_TRUSTED_PROXIES=127.0.0.1
WS_MAX_CONNECTIONS=512
WS_MAX_PER_IP=24
WS_ROOM_CREATES_PER_MINUTE=12
WS_UNSEATED_TIMEOUT_MS=60000
